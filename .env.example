# Configurações Databricks (Copiar para .env local e preencher - NUNCA commitar .env)
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=dapi_seu_token_aqui
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_NAME=/Users/seu_email/passos-magicos-mlops
DATABRICKS_SERVING_ENDPOINT=passos-magicos-predictor

# Configurações da API / Aplicação Local
MODEL_STAGE=Production
MODEL_NAME=passos_magicos_ipv_classifier
LOG_LEVEL=INFO
